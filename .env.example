# Copy this file to .env and adjust values before running `docker compose up`.
# .env is gitignored — never commit real secrets.

# --- PostgreSQL ---
POSTGRES_DB=coffeehub
POSTGRES_USER=coffeehub
POSTGRES_PASSWORD=coffeehub

# --- Backend (Spring Boot) ---
# Generate a real random 32+ char secret for anything beyond local dev,
# e.g.: openssl rand -base64 48
JWT_SECRET=dev-only-change-this-secret-in-production-min-32-chars
JWT_EXPIRATION_MS=86400000

# Origin allowed to call the API (comma-separated for multiple)
FRONTEND_URL=http://localhost:5173

# First admin account, auto-created on first backend startup if it doesn't exist
ADMIN_SEED_EMAIL=admin@coffeehub.in
ADMIN_SEED_PASSWORD=Admin@12345
SEED_ADMIN=true

# Hibernate schema strategy: "update" for local dev, use migrations (e.g. Flyway) for production
JPA_DDL_AUTO=update
